<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('partials/navbar') %>

  <main>
    <section class="detail-section">
      <article class="product-detail-card">
        <h1><%= product.name %></h1>
        <p class="category">Kategori: <%= product.category %></p>
        <p class="price">Harga: Rp <%= product.price.toLocaleString('id-ID') %></p>
        <p class="stock">Stok tersedia: <%= product.stock %></p>
        <a href="/produk" class="btn-secondary">Kembali ke Daftar Produk</a>
      </article>

      <aside class="detail-note">
        <p>Butuh info lain seputar produk ini? Coba fitur <a href="/tanya-ai">Tanya AI</a> kami.</p>
      </aside>
    </section>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/main.js"></script>
</body>
</html>