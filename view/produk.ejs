<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('partials/navbar') %>

  <main>
    <section class="produk-header">
      <h1>Daftar Produk</h1>

      <form class="filter-form" action="/produk" method="GET">
        <div class="form-group">
          <label for="search">Cari Produk</label>
          <input
            type="text"
            id="search"
            name="search"
            placeholder="Contoh: beras"
            value="<%= search %>"
          />
        </div>

        <div class="form-group">
          <label for="kategori">Kategori</label>
          <select id="kategori" name="kategori">
            <option value="" <%= kategori === "" ? "selected" : "" %>>Semua</option>
            <option value="sembako" <%= kategori === "sembako" ? "selected" : "" %>>Sembako</option>
            <option value="minuman" <%= kategori === "minuman" ? "selected" : "" %>>Minuman</option>
          </select>
        </div>

        <button type="submit" class="btn-primary">Filter</button>
      </form>
    </section>

    <section class="produk-list">
      <% if (products.length === 0) { %>
        <p class="empty-message">Tidak ada produk yang cocok dengan filter kamu.</p>
      <% } else { %>
        <div class="product-grid">
          <% products.forEach(function(p) { %>
            <article class="product-card">
              <h3><%= p.name %></h3>
              <p class="category"><%= p.category %></p>
              <p class="price">Rp <%= p.price.toLocaleString('id-ID') %></p>
              <p class="stock">Stok: <%= p.stock %></p>
              <a href="/produk/<%= p.id %>" class="btn-secondary">Lihat Detail</a>
            </article>
          <% }); %>
        </div>
      <% } %>
    </section>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/main.js"></script>
</body>
</html>