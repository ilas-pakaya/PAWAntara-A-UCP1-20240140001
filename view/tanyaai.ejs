<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('partials/navbar') %>

  <main>
    <section class="chat-section">
      <h1>Tanya AI</h1>
      <p>Punya pertanyaan seputar produk atau toko kami? Tanyakan di sini.</p>

      <div class="chat-box" id="chatBox" aria-live="polite">
        <p class="chat-message chat-bot">Halo! Ada yang bisa saya bantu?</p>
      </div>

      <form class="chat-form" id="chatForm">
        <label for="chatInput">Tulis pertanyaan kamu</label>
        <div class="chat-input-row">
          <input
            type="text"
            id="chatInput"
            name="chatInput"
            placeholder="Contoh: gula sekilo berapa?"
            required
          />
          <button type="submit" class="btn-primary">Kirim</button>
        </div>
      </form>
    </section>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/main.js"></script>
</body>
</html>