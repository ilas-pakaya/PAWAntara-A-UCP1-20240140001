<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('partials/navbar') %>

  <main>
    <section class="hero">
      <div class="hero-content">
        <h1>Belanja Kebutuhan Pokok Jadi Lebih Mudah</h1>
        <p>Cek stok dan harga terbaru, langsung tanya lewat fitur Tanya AI kami.</p>
        <a href="/produk" class="btn-primary">Lihat Semua Produk</a>
      </div>
    </section>

    <section class="preview-section">
      <h2>Produk Pilihan</h2>
      <div class="product-grid">
        <% preview.forEach(function(p) { %>
          <article class="product-card">
            <h3><%= p.name %></h3>
            <p class="category"><%= p.category %></p>
            <p class="price">Rp <%= p.price.toLocaleString('id-ID') %></p>
            <p class="stock">Stok: <%= p.stock %></p>
            <a href="/produk/<%= p.id %>" class="btn-secondary">Lihat Detail</a>
          </article>
        <% }); %>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/main.js"></script>
</body>
</html>
